const shops = require('./src/shops');
const ai = require('./src/ai');
require('dotenv').config();

async function runTest(testMessage) {
    console.log(`\n--- 🧪 TESTING MESSAGE: "${testMessage}" ---`);
    try {
        // 1. Refresh Cache
        await shops.refreshCache();

        // 2. Get Context
        console.log("🔎 Step 2: Running Search Logic...");
        const context = shops.getShopContext(testMessage);
        
        if (context) {
            console.log("✅ Context Found:");
            console.log(context);
        } else {
            console.log("⚠️ No specific context found.");
        }

        // 3. Get AI Response
        console.log("🤖 Step 3: Contacting AI...");
        const response = await ai.askAI(testMessage, context);

        console.log("\n--- 📱 FINAL BOT RESPONSE ---");
        console.log(response);
        console.log("------------------------------\n");

    } catch (error) {
        console.error("❌ TEST FAILED:", error.message);
    }
}

async function start() {
    await runTest("Where can I buy Pioneer in Bomet?");
    await runTest("Insecticides in Kipsitet");
    await runTest("Where can I do soil testing in Litein?");
    process.exit(0);
}

